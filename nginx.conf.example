# Example nginx config for Raspberry Pi reverse proxy
# Place in /etc/nginx/sites-available/ and symlink to sites-enabled/
#
# ВНИМАНИЕ: этот пример проксирует с ДРУГОЙ машины (lan-server-ip:8005), а с 2026-08-05
# docker-compose.yml публикует порт только на 127.0.0.1 — снаружи он не доступен.
# Для такой схемы придётся вернуть публикацию на 0.0.0.0 и закрыть порт файрволом.
# Рабочий конфиг этого проекта — nginx/tg-check-splitter.conf: nginx стоит на том же
# хосте и ходит на 127.0.0.1:8005.

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    # API and static files
    location / {
        proxy_pass http://lan-server-ip:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # WebSocket
    location /ws/ {
        proxy_pass http://lan-server-ip:8005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
